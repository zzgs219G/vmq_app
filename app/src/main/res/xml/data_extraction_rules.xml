<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则。同样排除存有通讯密钥的 SharedPreferences。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="v_mq_settings.xml" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="v_mq_settings.xml" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
